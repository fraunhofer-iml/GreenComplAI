{
  "extends": "@dpp/config/tsconfig/base",
  "compilerOptions": {
    // playwright.config.ts reads process.env (Node); the spec's page.evaluate
    // callbacks reference window (DOM, but running in the browser, not here) —
    // neither is covered by base.json's plain ES2023 lib.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["tests", "playwright.config.ts"]
}
