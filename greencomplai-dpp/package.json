{
  "name": "dpp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "db:migrate": "pnpm --filter @dpp/db db:migrate",
    "db:seed": "pnpm --filter @dpp/db db:seed",
    "dev": "sh scripts/dev.sh",
    "dev:apps": "turbo run dev --parallel --filter=@dpp/api --filter=web",
    "dev:infra": "docker compose up -d postgres minio",
    "dev:simpl-mock": "pnpm --filter @dpp/connector-simpl dev:mock",
    "format": "prettier --write . && pnpm --filter web format",
    "format:check": "prettier --check . && pnpm --filter web format:check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:smoke": "./scripts/smoke.sh",
    "typecheck": "turbo run typecheck",
    "check:public-files": "node scripts/check-public-files.mjs",
    "check:secrets": "sh scripts/check-secrets.sh",
    "lint:commit": "commitlint",
    "check:dependencies": "pnpm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dpp/config": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0"
}
