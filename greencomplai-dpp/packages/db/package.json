{
  "name": "@dpp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./migrations": "./src/migrations.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dpp/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@dpp/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0"
}
