# Local development only. Production needs generated secrets and its own users.
DATABASE_URL=postgres://dpp:dpp@localhost:5432/dpp
# Deployment mode: self-hosted (default) or saas
DEPLOYMENT_MODE=self-hosted
# Registration policy: false (default) = invite-only, only invited emails may
# register; true = open self-service signup (SaaS onboarding).
ALLOW_OPEN_SIGNUP=false

# Two-factor auth (TOTP). Enrolment is always possible; this switch enforces a
# second factor on administrative endpoints (member/invitation management).
# Off by default: turning it on for an instance whose admins are not enrolled yet
# would lock them out. Enrol first, then switch on.
REQUIRE_ADMIN_TWO_FACTOR=false
TWO_FACTOR_ISSUER=DPP Platform
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Only needed when the frontend runs on a sibling subdomain of the API: without
# it the session cookie is host-only and the frontend's server-side route guard
# never sees a session. Every host under this domain receives the cookie, so
# keep it as narrow as the deployment allows.
# SESSION_COOKIE_DOMAIN=.example.com
# Rate limiting (per client IP). Disable only for tests.
RATE_LIMIT_ENABLED=true
# Comma-separated client IPs exempt from rate limits (e.g. authorities).
RATE_LIMIT_ALLOWLIST=
WEB_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_ORIGIN=http://localhost:3000
VITE_API_ORIGIN=http://localhost:3000
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_ADMIN_NAME=Demo Admin
DEMO_ADMIN_PASSWORD=DemoAdmin123!
# Invitation mail. Optional: without SMTP_HOST an invitation is still created and
# the admin hands the link over manually — inviting never fails on mail delivery.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=DPP Platform <noreply@example.com>

S3_ENDPOINT=http://localhost:9000
# Only needed when the API reaches storage on an internal address the browser
# cannot resolve; presigned download URLs are signed against this one instead.
# S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_REGION=local
S3_BUCKET=dpp
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123

# Uploads are streamed through the API so size, MIME type and content sniffing
# can be enforced server-side. Downloads are handed out as short-lived presigned
# URLs; the TTL bounds how long a leaked link stays usable.
UPLOAD_MAX_BYTES=26214400
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/webp,text/csv,text/plain,application/xml,text/xml,application/json
DOWNLOAD_URL_TTL_SECONDS=300

# Optional malware scanning via ClamAV (docker compose --profile scan up -d clamav).
# Without CLAMAV_HOST only the signature/sniffing checks apply.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000
# Fail-closed: reject an upload when the scanner is missing or unreachable.
# Set to true for regulated deployments.
CLAMAV_REQUIRED=false

# Background jobs (pg-boss, same Postgres). Enable on exactly one process,
# otherwise several replicas schedule the same job.
WORKER_ENABLED=false
BLOB_CLEANUP_CRON=17 3 * * *
BLOB_ORPHAN_GRACE_HOURS=48

# Connectors to third-party systems (ERP/PLM/PIM/MES). The credentials of
# installed modules are stored encrypted under this key (AES-256-GCM). It is
# deliberately not kept in the database: a stolen database dump alone must not
# yield working ERP credentials. Without it, no connector carrying a secret can
# be installed - the attempt is rejected rather than stored in cleartext.
# Generate with: openssl rand -base64 32
# CONNECTOR_SECRET_KEY=

# --- Local connector mock ---
# Override a connector host only for local development. Production rejects it
# because the host determines where stored connector credentials are sent.
# Format: comma-separated connectorKey=url entries.
# Set this here so the API reads it independently of the task runner.
# Start the mock with pnpm dev:simpl-mock (port 4010, dev-client/dev-secret).
# CONNECTOR_BASE_URL_OVERRIDES=simpl=http://localhost:4010
